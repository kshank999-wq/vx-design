# Copy to apps/web/.env.local (web) or services/*/.env (workers). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/worker only — bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Web server only: signs assistant answers (scripts/set-assistant-key.sh prints it). Never NEXT_PUBLIC_.
VX_ASSISTANT_SIGNING_KEY=
# Web server: public address for confirmation-email links (defaults to the request host).
# VX_SITE_URL=https://vx.example.com

# Planning model (server only). With ANTHROPIC_API_KEY set, requirement extraction and
# planning use Claude (default claude-opus-5-5, override with VX_PLANNING_MODEL).
ANTHROPIC_API_KEY=
# VX_PLANNING_MODEL=claude-opus-5-5
# Set VX_LLM=offline to use the deterministic keyword heuristic instead (development/tests; not AI).
# VX_LLM=offline

# Part sourcing (workers). A worker takes sourcing tasks only when at least one distributor is configured.
# Primary: Nexar (Octopart data), OAuth2 client credentials, scope supply.domain. Billed per part returned.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
# Fallback A: DigiKey Product Information v4 (OAuth2 client credentials).
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# DIGIKEY_LOCALE_SITE=US
# DIGIKEY_LOCALE_CURRENCY=USD
# Fallback B: Mouser Search API key.
MOUSER_API_KEY=
# VX_SOURCING=fixture  uses invented fixture distributors (tests/development; labelled everywhere)
