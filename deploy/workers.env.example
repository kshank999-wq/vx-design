# Worker environment. Copy to deploy/workers.env on the worker host; never commit the copy.
SUPABASE_URL=https://<project-ref>.supabase.co
# Bypasses row level security: keep it on the worker host only.
SUPABASE_SERVICE_ROLE_KEY=

# Claude (planning, design generation, assistant tasks). Without it, set VX_LLM=offline (labelled, not AI).
ANTHROPIC_API_KEY=
# VX_PLANNING_MODEL=claude-opus-5-5

# Part sourcing: at least one, or sourcing tasks wait. DigiKey and Mouser (free APIs) are asked first; Nexar/Octopart
# (billed per part) is optional and only asked for parts the free ones do not find.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=

# Concept images: one of these (Gemini preferred when both are set), or VX_IMAGES=off.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Tuning
# WORKER_CONCURRENCY=2
# VX_COMPUTE_USD_PER_HOUR=0.10

# Automatic updates (the "updater" service): a GitHub token with read:packages, so new worker images can be pulled.
# GHCR_USER=<your GitHub user name>
# GHCR_TOKEN=
