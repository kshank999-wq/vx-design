{
  "name": "vx-design",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vx/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "./scripts/test-db.sh",
    "test:e2e": "NODE_PATH=$(npm root -g) node apps/web/e2e/g1-flow.mjs",
    "worker": "node services/orchestrator/src/main.ts",
    "test:worker": "./scripts/test-worker.sh",
    "test:e2e:g2": "./scripts/test-e2e-g2.sh",
    "test:eng": "cd services/engineering && docker run --rm -v $PWD:/src -w /src --entrypoint python3 vx-engineering-worker -m unittest discover -s tests",
    "test:g3": "./scripts/test-g3.sh",
    "test:e2e:g3": "./scripts/test-e2e-g3.sh",
    "test:g4": "./scripts/test-g4.sh",
    "test:e2e:g4": "./scripts/test-e2e-g4.sh",
    "test:g45": "./scripts/test-g45.sh",
    "test:e2e:g45": "./scripts/test-e2e-g45.sh",
    "test:msrc": "./scripts/test-msrc.sh",
    "test:e2e:msrc": "./scripts/test-e2e-msrc.sh",
    "test:e2e:power": "./scripts/test-e2e-power.sh",
    "test:models": "./scripts/test-models.sh",
    "test:e2e:models": "./scripts/test-e2e-models.sh",
    "test:enclosure": "./scripts/test-enclosure.sh",
    "test:e2e:enclosure": "./scripts/test-e2e-enclosure.sh",
    "test:e2e:workspace": "./scripts/test-e2e-workspace.sh",
    "test:e2e:knowledge": "./scripts/test-e2e-knowledge.sh",
    "test:e2e:concepts": "./scripts/test-e2e-concepts.sh",
    "test:e2e:rfq": "./scripts/test-e2e-rfq.sh",
    "test:e2e:flux": "./scripts/test-e2e-flux.sh",
    "test:e2e:security": "./scripts/test-e2e-security.sh",
    "test:e2e:optimize": "./scripts/test-e2e-optimize.sh",
    "test:e2e:validation": "./scripts/test-e2e-validation.sh",
    "test:e2e:quotas": "./scripts/test-e2e-quotas.sh",
    "check:integrity": "./scripts/check-integrity.sh",
    "drill:backup": "./scripts/backup-drill.sh",
    "test:regression": "node tests/regression/run.ts",
    "test:regression:engineering": "node tests/regression/run.ts --engineering"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
